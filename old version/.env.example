# SurgInsight environment example
#
# Frontend:
#   Copy the frontend variables below into frontend/.env.local when needed.
#
# Backend:
#   The backend currently reads environment variables from the system shell.
#   If you want to use SURGPHASE_ROOT, set it in your terminal before starting uvicorn.

# -----------------------------
# Frontend (Vite)
# Example target file: frontend/.env.local
# -----------------------------
VITE_API_BASE_URL=http://127.0.0.1:8001

# -----------------------------
# Backend
# Set in PowerShell before starting the backend if local weights are not placed
# under backend/pretrained_weights/.
# Example:
#   $env:SURGPHASE_ROOT="D:\project\SurgPhase"
# -----------------------------
SURGPHASE_ROOT=D:\project\SurgPhase
